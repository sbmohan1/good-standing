# Anthropic API key used by packages/extract to read formation documents.
ANTHROPIC_API_KEY=

# Model used for extraction.
ANTHROPIC_MODEL=claude-sonnet-5-5

# Optional: a Stripe *agent* API key (restricted key with the Agent tag, read-only:
# balance read; Treasury financial account read if present). Used only for gross-assets hints.
STRIPE_AGENT_KEY=
